meta {
  name: 03 - Consulter Bâtiments
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/buildings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Liste bâtiments — 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Résultat est un tableau", function() {
    expect(res.body).to.be.an("array");
    expect(res.body.length).to.be.above(0);
  });
}

docs {
  ## Flux nominal — Étape 3 : L'app mobile consulte les bâtiments

  L'opérateur authentifié récupère la liste des bâtiments auxquels il a accès.

  **Prérequis** : token opérateur en `{{token}}` (étape 02).

  **RBAC** : rôle `operator` autorisé par `requireRole("admin", "operator")`.

  **Résultat attendu** : 200 OK — tableau de bâtiments (b-001, b-002...).
}