meta {
  name: Login (admin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "Admin1234!"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setVar("token", res.body.token);
    console.log("Token sauvegardé dans {{token}}");
  }
}
